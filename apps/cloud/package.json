{
  "name": "parserium-cloud",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "operator": "node scripts/operator.mjs",
    "staging:config": "node scripts/staging-config.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:google-discovery": "node --test tests/google-live.mjs",
    "check": "node --check src/worker.mjs && node --check src/auth.mjs && node --check src/google.mjs && node --check src/identity.mjs",
    "build": "esbuild src/worker.mjs --bundle --format=esm --platform=browser --target=es2022 --external:cloudflare:workers --outfile=.wrangler/build/worker.js",
    "build:app": "npm --prefix ../web run build:cloud && npm run build"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "oauth4webapi": "3.8.8"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "miniflare": "5.20260911.0-alpha",
    "wrangler": "4.131.1"
  }
}
